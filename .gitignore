# ---- build outputs -------------------------------------------------------
build/
build-cli/
build-logs/
dist/
*.pkg
*.toc

# ---- downloaded toolchains & runtimes (regenerated by tools/) ------------
# ~9 MB of PyInstaller and ~30 MB of embeddable Python; both are fetched by
# tools/fetch_buildtools.py and tools/fetch_python_embed.py.
buildtools/
embed-python/
portable/

# ---- binary artifacts ----------------------------------------------------
# The packaged EXEs live in the release folder / zip, not in the repo:
# rebuilt by `python tools/build.py`.
*.exe

# ---- runtime state -------------------------------------------------------
# Portable mode stores config + index cache here. Never commit: the index
# embeds the extracted text of every scanned file.
data/

# ---- test corpus ---------------------------------------------------------
# 3400 synthetic spreadsheets (~40 MB) + hardlink farm, generated by
# tools/make_testdata.py
testdata/
testdata_big/
.refresh-test/
.svgpreview/
.runtime-tmp/
.tmp/

# ---- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
